# MockSocial environment — copy to `.env` for local dev.
# ADR-0004: bare Node + native Postgres locally; no SQLite substitute.

# Postgres connection string. Match the Postgres major version to the server image.
DATABASE_URL=postgresql://mocksocial:mocksocial@localhost:5432/mocksocial

# Secret used to sign/validate session cookies. Generate a long random value.
SESSION_SECRET=change-me-to-a-long-random-string

# Node environment
NODE_ENV=development
